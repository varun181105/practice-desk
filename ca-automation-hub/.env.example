PORT=3000
FIRM_PASSWORD=replace-with-a-long-unique-password

# Choose one persistent database:
# Supabase REST (requires the SQL setup in README.md)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Recommended for server-side writes; keep this secret and never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Native reminder email (use a Gmail app password when EMAIL_SERVICE=gmail)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
PUBLIC_PORTAL_URL=
INBOUND_WEBHOOK_SECRET=
INBOUND_WEBHOOK_SECRET=

# Or use a PostgreSQL or MongoDB connection string:
DATABASE_URL=

# Optional integrations:
ANTHROPIC_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
